<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 这个 App 不收集任何数据：没有账号、没有网络请求、没有分析 SDK。
         所有内容（词库、词典、书、复习进度）都只存在设备本地。 -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- 需要声明使用理由的 API。Apple 自 2024 年起强制要求。 -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <!-- @AppStorage 用的是 UserDefaults：每日额度、振假名开关、备考目标等
                 设备偏好。只读写本 App 自己的数据，对应理由 CA92.1。 -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <!-- 导入书籍时读取用户选中的文件，需要访问文件时间戳。
                 对应理由 C617.1：仅访问用户主动提供的文件。 -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <!-- SwiftData / SQLite 会查询磁盘可用空间。对应理由 E174.1。 -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
